VITE_API_BASE_URL=/api
VITE_USE_REMOTE_QUIZ_API=false
VITE_DEV_API_TARGET=http://127.0.0.1:8787

API_PORT=8787
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
SECURITY_STATUS_ENABLED=true
ANALYTICS_CACHE_TTL_MS=15000

# Private mailbox — use unique secrets of at least 32 characters. Never commit a real .env file.
MAILBOX_ACCESS_CODE_PEPPER=replace-with-a-unique-32-character-or-longer-secret
MAILBOX_ENCRYPTION_SECRET=replace-with-a-unique-32-character-or-longer-secret
MAILBOX_ADMIN_TOKEN=replace-with-a-unique-32-character-or-longer-secret
MAILBOX_MAINTENANCE_TOKEN=replace-with-a-unique-32-character-or-longer-secret
MAILBOX_SUBMISSION_WINDOW_MS=86400000
MAILBOX_SUBMISSION_MAX=3

# Vercel + Supabase production integration. These server-side values must never use VITE_ prefixes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-the-server-side-supabase-secret-key
CRON_SECRET=replace-with-a-separate-32-character-or-longer-secret

# Only these browser-safe values can use VITE_ in a Vite app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-the-public-supabase-publishable-key
